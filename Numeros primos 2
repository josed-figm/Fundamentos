#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    bool flag = true;
    int n,cont=2, cont2=0;
    cout<<"Ingresar el numero hasta donde llegar:";
    cin>>n;
    while (cont2 < n)
    {
        flag = true;
        for (int i=2;i<=sqrt(cont);i++)
            if (cont%i==0){
            flag= false;
                break;
            }
        if (flag)
        {
            cout<<cont<<",";                
            cont2++;
        }
        cont++;
        
    }
    return 0;
}
