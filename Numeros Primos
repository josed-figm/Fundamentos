#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int n,cont=2;
    cout<<"Ingresar el numero hasta donde llegar:";
    cin>>n;
    while (cont<n)
    {
        bool flag = true;
        for (int i=2;i<=sqrt(cont);i++){
            if (cont%i==0){
            flag= false;
                break;
            }
        }
        if (flag)
            cout<<cont<<",";                
        cont++;
    }
    return 0;
}
